# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 실제 값으로 채워주세요.
# secrets.toml은 .gitignore에 포함되어 있어 GitHub에는 올라가지 않습니다.
# Streamlit Community Cloud에 배포한 경우에는 이 파일 대신
# 앱 관리 화면(Manage app > Settings > Secrets)에 같은 내용을 붙여넣으면 됩니다.

GMAIL_USER = "your-gmail@gmail.com"
GMAIL_APP_PASSWORD = "16자리 앱 비밀번호 (공백 없이)"
RECIPIENT_EMAIL = "상담 신청을 받을 이메일 주소"
